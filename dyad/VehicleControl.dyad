      "children": {
        "Power limit": {
          "contents": [
            "total_max_power"
          ]
        }
      }
    }
  },
  "_links": {
    "tc": {
      "Dyad": {
        "placement": {
          "diagram": {
            "x1": 450,
            "x2": 550,
            "y1": 320,
            "y2": 420
          }
        }
      }
    },
    "abs": {
