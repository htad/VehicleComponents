          "tire.MZ_RESIDUAL_RATE": 4
        },
        "atol": {"tire.Fx": 0.2, "tire.Fy": 0.2, "tire.Mz": 0.01},
        "expect": {"signals": ["tire.Fx", "tire.Fy", "tire.Mz"]}
      },
      "spin_at_rest": {
        "stop": 0.2,
        "params": {"speed": 0, "spin_excess": 1.0},
        "atol": {"tire.Fx": 0.2, "tire.Fy": 0.2},
        "expect": {"signals": ["tire.Fx", "tire.Fy"]}
      }
    }
  },
