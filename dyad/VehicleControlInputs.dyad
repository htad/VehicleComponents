connector VehicleControlInputs
  input throttle::Real(units = "1")
  input brake::Real(units = "1")
  input slip_fl::Real(units = "1")
  input slip_fr::Real(units = "1")
  input slip_rl::Real(units = "1")
  input slip_rr::Real(units = "1")
  input motor_speed_fl::AngularVelocity
  input available_torque_fl::Torque
  input motor_speed_fr::AngularVelocity
  input available_torque_fr::Torque
  input motor_speed_rl::AngularVelocity
  input available_torque_rl::Torque
  input motor_speed_rr::AngularVelocity
  input available_torque_rr::Torque
metadata {
  "Dyad": {
    "icons": {
      "default": "dyad://Dyad/RealInput.svg"
    }
  }
}
end
